\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Comparative spectral convergence of resonant wavenumber $k_c$ for $TE_z$ modes in a 2D PEC cavity over 6 refinement levels between Pure VNMM 2D on structured Cartesian grids (alternating directors) and on irregular point clouds ($25\%$ spatial jitter and random director orientations $\theta _k \in [0, 2\pi )$) under identical numerical conditions ($3 \times 3$ Gauss quadrature, background cells $N_c = N_v - 1$, $s_{\mathrm  {div}} = 6.0$, $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle \mathrm  {Tol}$}\mathaccent "0362{\mathrm  {Tol}} = 0.80$).}}{72}{table.216}\protected@file@percent }
\newlabel{tab:convergencia_cavidade_aleatoria}{{8}{72}{Comparative spectral convergence of resonant wavenumber $k_c$ for $TE_z$ modes in a 2D PEC cavity over 6 refinement levels between Pure VNMM 2D on structured Cartesian grids (alternating directors) and on irregular point clouds ($25\%$ spatial jitter and random director orientations $\theta _k \in [0, 2\pi )$) under identical numerical conditions ($3 \times 3$ Gauss quadrature, background cells $N_c = N_v - 1$, $s_{\mathrm {div}} = 6.0$, $\widehat {\mathrm {Tol}} = 0.80$)}{table.216}{}}
